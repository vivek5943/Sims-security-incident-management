# ─────────────────────────────────────────────────────────────────────────────
# SIMS Environment Configuration
# Copy to .env and fill in all values — .env is NEVER committed to git
# ─────────────────────────────────────────────────────────────────────────────

# FIX-01: SECRET_KEY has no default — will crash fast if missing (intentional)
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_MINIMUM_50_CHARS

# FIX-01: DEBUG must be explicitly set — defaults to False if not present
DEBUG=True

# FIX-01: Explicit host list — no wildcard
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=sims_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email / SMTP (MOD-05 notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SIMS Platform <noreply@sims.com>

# Production only (leave blank in dev)
SECURE_SSL_REDIRECT=False
